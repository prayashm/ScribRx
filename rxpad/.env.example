# Base URL of the PocketBase backend.
#
# Leave EMPTY to run ScribRx in fully local mode (IndexedDB-only storage,
# bring-your-own AI key, client-side QR signing) — the original zero-backend PWA.
#
# Set it to your deployed PocketBase URL to enable accounts, cloud sync,
# the server-side AI proxy, and hosted QR verification.
#   local dev:  http://127.0.0.1:8090
#   production: https://your-pocketbase-host.example.com
VITE_PB_URL=
